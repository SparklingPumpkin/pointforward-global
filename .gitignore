__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
.idea/
.vscode/

# User data and generated state are never part of the delivery repository.
data/
datasets/
outputs/
runs/
cache/
tmp/
artifacts/
*.mp4
*.avi
*.ply
*.pt.tmp

# Keep Git small: only the PointForward checkpoint is versioned.  Depth,
# segmentation, ImageNet initialization and scene-specific refiner weights
# remain usable in an existing working tree but are supplied out of band.
weights/*
!weights/README.md
!weights/manifest.json
!weights/pointforward_waymo_ds_paper_ckpt_020000.pt

# Optional ABI-specific binary is delivered on disk and hashed in the release.
docs/releases/VR-v1-s/source/gsplat_cuda.so
# Retain representative review sheets and manifests, not every rendered frame.
docs/releases/*/run-*/replay/runtime-render-source/frames/
